generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         Int      @id @default(autoincrement())
  aliId      String   @unique
  title      String
  price      Float
  currency   String   @default("USD")
  imageUrl   String
  productUrl String
  category   String
  rating     Float?
  soldCount  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
